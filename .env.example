# Configuracion LOCAL de laboratorio. Start-Local.ps1 crea .env si no existe.
# ASP.NET Core no carga .env automaticamente; utiliza el script de arranque.
# Esta clave de ejemplo es solo para PostgreSQL local, publicado en 127.0.0.1.
POSTGRES_DB=TallerMecanicoDb
POSTGRES_USER=taller
POSTGRES_PASSWORD=taller_solo_desarrollo
POSTGRES_PORT=55434
LocalDatabase__Enabled=true
ConnectionStrings__DefaultConnection=Host=localhost;Port=55434;Database=TallerMecanicoDb;Username=taller;Password=taller_solo_desarrollo;SSL Mode=Disable
Cors__AllowedOrigins__0=http://localhost:5080
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
# Para Neon: usa config/neon.env.example como referencia. No uses SSL Mode=Disable en Neon.
