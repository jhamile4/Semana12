{
  "info": {
    "name": "Semana 12 Gestión de Taller Mecánico",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar completa en orden sobre datos de laboratorio. Crea y elimina sus propios registros. No modifica los datos iniciales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName.startsWith('01 ')) {",
          "const id=Date.now().toString()+Math.floor(Math.random()*100000);",
          "const dni=String(10000000+Math.floor(Math.random()*80000000));",
          "pm.collectionVariables.set('runId',id); pm.collectionVariables.set('dni',dni);",
          "pm.collectionVariables.set('otroDni',String(Number(dni)+1));",
          "const letras=[0,1,2].map(()=>String.fromCharCode(65+Math.floor(Math.random()*26))).join('');",
          "pm.collectionVariables.set('placa',letras+'-'+String(100+Math.floor(Math.random()*900)));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Crear cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/clientes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Cliente Postman\",\n  \"dni\": \"{{dni}}\",\n  \"telefono\": \"987654321\",\n  \"email\": \"taller-{{runId}}@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('clienteId', pm.response.json().idCliente);",
              "pm.test('Location del recurso', () => pm.expect(pm.response.headers.get('Location')).to.match(/api\\//i));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Crear segundo cliente",
