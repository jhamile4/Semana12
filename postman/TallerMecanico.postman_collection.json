        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Incluye cliente creado', () => pm.expect(pm.response.json().some(x => x.idCliente === Number(pm.collectionVariables.get('clienteId')))).to.be.true);"
            ]
          }
        }
      ]
    },
