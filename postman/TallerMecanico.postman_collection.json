              "pm.collectionVariables.set('otroClienteId', pm.response.json().idCliente);",
              "pm.test('Location del recurso', () => pm.expect(pm.response.headers.get('Location')).to.match(/api\\//i));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Listar clientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/clientes"
